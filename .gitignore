# --- Données générées (reconstruites automatiquement au 1er lancement) ----
# Sources brutes téléchargées (~13 Mo) : régénérables via `python -m quranlab init`
data/raw/
# Base SQLite (~29 Mo) : construite automatiquement par l'app si absente.
# Pour un démarrage instantané en ligne, commentez la ligne ci-dessous et
# versionnez data/quran.db (Streamlit Cloud le clonera tel quel).
data/quran.db
# Favoris (versets mis de côté), propres à chaque instance.
data/bookmarks.json

