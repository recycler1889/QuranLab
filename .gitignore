# --- Données générées (reconstruites automatiquement au 1er lancement) ----
# Sources brutes téléchargées (~13 Mo) : régénérables via `python -m quranlab init`
data/raw/
# Base SQLite PRÉCONSTRUITE (~34 Mo) : versionnée pour un démarrage INSTANTANÉ
# sur Streamlit Cloud (sinon l'app la télécharge et la construit au premier
# lancement, d'où une longue attente « qui charge en vain »). Pour ne pas la
# versionner, décommentez la ligne ci-dessous.
# data/quran.db
# Favoris (versets mis de côté), propres à chaque instance.
data/bookmarks.json
# Progression d'apprentissage (cartes SRS, objectifs), propre à chaque instance.
data/learning.json
# Modèles de voix Piper (~20-60 Mo chacune), téléchargés à la demande.
data/piper/

